# =====================================================================
#  CONFIGURACION DEL BOT  -  copia este archivo como ".env"
#  (o ejecuta el script OBS-Autorizar-Bot.cmd, que lo genera solo)
# =====================================================================

# ----- TU CANAL (sin la @, en minusculas) -----
CHANNEL=jonasrdb

# ----- CUENTA DEL BOT -----
# Recomendado: una cuenta aparte para el bot (creala en twitch.tv/signup).
# Si pones tu misma cuenta, el bot hablara con tu nombre y necesitaras
# ser moderador de ti mismo (ya lo eres), pero se mezclara con tus mensajes.
BOT_USERNAME=jonasrdb

# ----- CREDENCIALES (las rellena src/auth.js automaticamente) -----
# Client ID de tu aplicacion en https://dev.twitch.tv/console/apps
BOT_CLIENT_ID=
# Token de acceso. Se genera con:  npm run auth
BOT_TOKEN=
# Token para renovar el acceso sin volver a autorizar (60 dias)
BOT_REFRESH_TOKEN=
# Cuando caduca el token (epoch en milisegundos). Lo rellena auth.js
BOT_TOKEN_EXPIRES_AT=

# ----- CEREBRO CON IA (opcional, pero muy recomendado) -----
# Sin clave, el bot usa el modo LOCAL (plantillas, gratis, sin internet).
# Con clave, el bot conversa de verdad, sigue el hilo de la conversacion y
# escribe el mismo los mensajes para animar el chat cuando esta parado.
#
# COMO CONSEGUIR LA CLAVE DE GROQ (gratis, sin tarjeta, 2 minutos):
#   1. Entra en https://console.groq.com/keys y crea una cuenta
#   2. Pulsa "Create API Key", ponle un nombre (por ejemplo bot-twitch)
#   3. Copia la clave (empieza por gsk_) y pegala aqui abajo
#   4. Reinicia el bot
#
# Modelo ya configurado en config.json > llm: openai/gpt-oss-120b
#   (con openai/gpt-oss-20b de reserva si el primero se satura)
# Limite de la capa gratuita: 1.000 peticiones/dia y 8.000 tokens/minuto.
# El bot lleva su propio tope de 800 al dia y, al llegar, sigue con el
# cerebro local sin cortarse.
LLM_API_KEY=
# Otros proveedores (cambia tambien llm.provider en config.json):
#   OpenAI      -> https://platform.openai.com/api-keys
#   DeepSeek    -> https://platform.deepseek.com/api_keys     (muy barato)
#   OpenRouter  -> https://openrouter.ai/keys
#   Ollama      -> no necesita clave (se ejecuta en tu propio PC, gratis)
